# Runtime connection, used by the app via the `repma_api` role (subject to RLS).
# Locally this role is created and given a login password by sub-task 1.4's
# `db:bootstrap` script, which reads REPMA_API_PASSWORD below.
DATABASE_URL=postgresql://repma_api:<REPMA_API_PASSWORD>@127.0.0.1:54322/postgres

# Admin connection used ONLY by migration tooling (drizzle-kit) to run schema
# migrations — never read by the running app, never deployed. Locally this is
# the local Supabase stack's superuser connection (`supabase start` output).
MIGRATIONS_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Password sub-task 1.4's db:bootstrap script uses to give `repma_api` LOGIN
# locally. Never committed with a real value; generate your own.
REPMA_API_PASSWORD=

# Runtime vars validated at startup by config/env.ts (RNF-12). Locally these
# come from `supabase status` once the stack is up.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
PORT=3000
# Comma-separated CORS allowlist (RNF-05) — the web dev server's origin(s).
FRONTEND_URLS=http://localhost:5173
NODE_ENV=development
